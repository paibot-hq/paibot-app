{
  "name": "paibot-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3002",
    "build": "react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "preview": "vite preview --port 3003",
    "start": "vite preview --port 3003",
    "test": "node --test \"tests/unit/*.test.mjs\" \"src/tools/*/*.test.mjs\"",
    "test:sympy": "uv run --locked python scripts/verify_math.py && uv run --locked python tests/unit/test_verify_math.py",
    "e2e": "node tests/e2e/run.mjs",
    "deploy": "wrangler deploy --config build/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:local:production": "wrangler d1 migrations apply DB --local --env production",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "goldfish:textures": "node scripts/goldfish/make-textures.mjs",
    "quiz:import:local": "node scripts/import-quiz.mjs local",
    "quiz:import:dev": "node scripts/import-quiz.mjs dev",
    "quiz:import:prod": "node scripts/import-quiz.mjs prod",
    "math:steps": "node scripts/math-steps.mjs",
    "math:describe": "node scripts/math-describe.mjs",
    "math:formulas": "node scripts/math-formulas.mjs",
    "breaches:check": "node scripts/check-breaches.mjs",
    "math:import:local": "node scripts/import-math.mjs local",
    "math:import:dev": "node scripts/import-math.mjs dev",
    "math:import:prod": "node scripts/import-math.mjs prod",
    "breaches:import:local": "node scripts/import-breaches.mjs local",
    "breaches:import:local:production": "node scripts/import-breaches.mjs local-production",
    "breaches:import:dev": "node scripts/import-breaches.mjs dev",
    "breaches:import:prod": "node scripts/import-breaches.mjs prod",
    "math:generate": "node scripts/math-generate.mjs",
    "math:review": "node scripts/math-review.mjs",
    "govfaq:build": "node scripts/govfaq-build.mjs",
    "govfaq:embed": "node scripts/govfaq-embed.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.16.1",
    "@clerk/react-router": "3.6.25",
    "@clerk/shared": "^4.34.0",
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.87",
    "drizzle-orm": "0.45.3",
    "isbot": "^5",
    "katex": "^0.18.7",
    "matter-js": "^0.20.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "sql.js": "^1.15.2",
    "three": "^0.186.1",
    "typescript5": "npm:typescript@^5.9.3",
    "use-intl": "^4.14.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.20.0",
    "@clerk/testing": "^2.2.38",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@react-router/dev": "8.4.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "drizzle-kit": "0.31.11",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
