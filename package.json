{
  "name": "paibot-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3001",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && npm run start",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@clerk/localizations": "^4.16.1",
    "@clerk/nextjs": "^7.9.2",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "katex": "^0.18.7",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
