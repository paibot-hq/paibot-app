{
  "name": "paibot-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3002",
    "build": "react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "preview": "vite preview --port 3003",
    "start": "vite preview --port 3003",
    "check:smoke": "node scripts/check-smoke.mjs",
    "check:browser": "node scripts/check-smoke.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "check:i18n": "node scripts/check-environments.mjs",
    "check:whois": "node scripts/check-whois.mjs",
    "deploy": "wrangler deploy --config build/server/wrangler.json",
    "check:auth": "node --env-file=.dev.vars scripts/check-auth.mjs",
    "check:favorites": "node --env-file=.dev.vars scripts/check-favorites.mjs",
    "check:access": "node scripts/check-access.mjs",
    "check:build-targets": "node scripts/check-build-targets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:local:production": "wrangler d1 migrations apply DB --local --env production",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "check:diary": "node --env-file=.dev.vars scripts/check-diary.mjs",
    "check:profile": "node --env-file=.dev.vars scripts/check-profile.mjs",
    "check:life-calendar": "node scripts/check-life-calendar.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:quiz": "node scripts/check-quiz.mjs",
    "check:quiz-browser": "node scripts/check-quiz-browser.mjs",
    "quiz:import:local": "node scripts/import-quiz.mjs local",
    "quiz:import:dev": "node scripts/import-quiz.mjs dev",
    "quiz:import:prod": "node scripts/import-quiz.mjs prod",
    "check:math-factorization": "node scripts/check-math-factorization.mjs",
    "check:math-arith": "node scripts/check-math-arith.mjs",
    "check:math-history": "node --env-file=.dev.vars scripts/check-math-history.mjs",
    "math:import:local": "node scripts/import-math.mjs local",
    "math:import:dev": "node scripts/import-math.mjs dev",
    "math:import:prod": "node scripts/import-math.mjs prod",
    "math:generate": "node scripts/math-generate.mjs",
    "math:review": "node scripts/math-review.mjs",
    "check:math-pythagoras": "node scripts/check-math-pythagoras.mjs",
    "check:cidr": "node scripts/check-cidr.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.16.1",
    "@clerk/react-router": "3.6.25",
    "@clerk/shared": "^4.34.0",
    "drizzle-orm": "0.45.3",
    "isbot": "^5",
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "use-intl": "^4.14.4"
  },
  "devDependencies": {
    "@clerk/backend": "^3.20.0",
    "@clerk/testing": "^2.2.38",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@react-router/dev": "8.4.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
