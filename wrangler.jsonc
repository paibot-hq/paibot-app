{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paibot-app-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // One Worker serves every site, told apart by host name (src/lib/sites.ts); the development hub is dev.paibot.dev.
  "routes": [
    { "pattern": "dev.paibot.dev", "custom_domain": true },
    { "pattern": "app-dev.paibot.dev", "custom_domain": true },
    { "pattern": "learn-dev.paibot.dev", "custom_domain": true },
    { "pattern": "tools-dev.paibot.dev", "custom_domain": true }
  ],
  // WHOIS_ROOT_SERVER and RDAP_BOOTSTRAP_URL are also test seams:
  // tests/e2e/whois.mjs points them at local fake servers. See src/tools/domain/whois.server.ts.
  // SITE_CHECK_ALLOW_PRIVATE is the same kind of seam for tests/e2e/site-check.mjs;
  // it must stay "false" in every deployed environment (src/tools/site-check/site-check.server.ts).
  // APP_VERSION is overridden at deploy (--var APP_VERSION:<commit>) and sent as
  // X-App-Version, so CI can wait until the new version is serving before checks.
  "vars": { "SITE_URL": "https://app-dev.paibot.dev", "SITE_INDEXABLE": "false", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "RDAP_BOOTSTRAP_URL": "https://data.iana.org/rdap/dns.json", "SITE_CHECK_ALLOW_PRIVATE": "false", "APP_VERSION": "local" },
  // Per-IP limit for the tools that make outbound requests (website status check,
  // domain lookup), so they cannot be scripted into a relay against other sites.
  // Bindings are not inherited: production has its own, in a separate namespace.
  "ratelimits": [{ "name": "TOOL_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // One shared DB for the whole app, not a per-feature database (infra/d1.tf).
  // Both environments use the Asia-Pacific databases (app_dev_apac/app_prod_apac):
  // the site targets Japan and the original ENAM ones added ~140ms per query.
  "d1_databases": [
    { "binding": "DB", "database_name": "paibot-app-dev-apac", "database_id": "11f4b088-e6f9-4c96-baa7-cfc1859ecae8" }
  ],
  // Select at BUILD time with CLOUDFLARE_ENV. Deploy the generated config
  // without --env. Names, routes and vars must be explicit in each env.
  "env": {
    "production": {
      "name": "paibot-app",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // The hub (paibot.dev) and its sites; paibot.app stays routed only to answer with a redirect (src/lib/legacy-host.ts).
      "routes": [
        { "pattern": "paibot.dev", "custom_domain": true },
        { "pattern": "app.paibot.dev", "custom_domain": true },
        { "pattern": "learn.paibot.dev", "custom_domain": true },
        { "pattern": "tools.paibot.dev", "custom_domain": true },
        { "pattern": "paibot.app", "custom_domain": true }
      ],
      "vars": { "SITE_URL": "https://app.paibot.dev", "SITE_INDEXABLE": "true", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "RDAP_BOOTSTRAP_URL": "https://data.iana.org/rdap/dns.json", "SITE_CHECK_ALLOW_PRIVATE": "false", "APP_VERSION": "local" },
      "ratelimits": [{ "name": "TOOL_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      // Not inherited from the top level - production has its own database
      // (infra/d1.tf's app_prod_apac), never the dev one.
      "d1_databases": [
        { "binding": "DB", "database_name": "paibot-app-apac", "database_id": "fdfaf455-d8c4-4652-a2a0-4ccda9ed1d61" }
      ]
    }
  }
}
