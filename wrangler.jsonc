{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paibot-app-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "dev.paibot.app", "custom_domain": true }],
  // WHOIS_ROOT_SERVER is also a test seam: scripts/check-whois.mjs points it
  // at a local fake WHOIS server via `wrangler dev --var`. See src/lib/whois.server.ts.
  // APP_VERSION is overridden at deploy (--var APP_VERSION:<commit>) and sent as
  // X-App-Version, so CI can wait until the new version is serving before checks.
  "vars": { "SITE_URL": "https://dev.paibot.app", "SITE_INDEXABLE": "false", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "APP_VERSION": "local" },
  // One shared DB for the whole app (favorites now, /math problem sets later
  // - see infra/d1.tf), not a per-feature database. Production has no D1 yet;
  // its own database will get its own binding under env.production once created.
  "d1_databases": [
    { "binding": "DB", "database_name": "paibot-app-dev", "database_id": "0465f7d2-f9bc-4ac6-8e61-352c422bee50" }
  ],
  // Select at BUILD time with CLOUDFLARE_ENV. Deploy the generated config
  // without --env. Names, routes and vars must be explicit in each env.
  "env": {
    "production": {
      "name": "paibot-app",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "paibot.app", "custom_domain": true }],
      "vars": { "SITE_URL": "https://paibot.app", "SITE_INDEXABLE": "true", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "APP_VERSION": "local" },
      // Not inherited from the top level - production has its own database
      // (infra/d1.tf's app_prod), never the dev one.
      "d1_databases": [
        { "binding": "DB", "database_name": "paibot-app", "database_id": "a881977a-b637-4590-9a0b-985e584683b4" }
      ]
    }
  }
}
