{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paibot-app-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "dev.paibot.app", "custom_domain": true }],
  "vars": { "SITE_URL": "https://dev.paibot.app", "SITE_INDEXABLE": "false" },
  // Select at BUILD time with CLOUDFLARE_ENV. Deploy the generated config
  // without --env. Names, routes and vars must be explicit in each env.
  "env": {
    "production": {
      "name": "paibot-app",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "paibot.app", "custom_domain": true }],
      "vars": { "SITE_URL": "https://paibot.app", "SITE_INDEXABLE": "true" }
    },
    "validation": {
      "name": "paibot-react-router-validation",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "rr-dev.paibot.app", "custom_domain": true }],
      "vars": { "SITE_URL": "https://rr-dev.paibot.app", "SITE_INDEXABLE": "false" }
    }
  }
}
