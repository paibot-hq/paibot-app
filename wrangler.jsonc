{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paibot-app-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "dev.paibot.app", "custom_domain": true }],
  // WHOIS_ROOT_SERVER and RDAP_BOOTSTRAP_URL are also test seams:
  // scripts/check-whois.mjs points them at local fake servers. See src/lib/whois.server.ts.
  // SITE_CHECK_ALLOW_PRIVATE is the same kind of seam for scripts/check-site-check.mjs;
  // it must stay "false" in every deployed environment (src/lib/site-check.server.ts).
  // APP_VERSION is overridden at deploy (--var APP_VERSION:<commit>) and sent as
  // X-App-Version, so CI can wait until the new version is serving before checks.
  "vars": { "SITE_URL": "https://dev.paibot.app", "SITE_INDEXABLE": "false", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "RDAP_BOOTSTRAP_URL": "https://data.iana.org/rdap/dns.json", "SITE_CHECK_ALLOW_PRIVATE": "false", "APP_VERSION": "local" },
  // One shared DB for the whole app, not a per-feature database (infra/d1.tf).
  // Both environments use the Asia-Pacific databases (app_dev_apac/app_prod_apac):
  // the site targets Japan and the original ENAM ones added ~140ms per query.
  "d1_databases": [
    { "binding": "DB", "database_name": "paibot-app-dev-apac", "database_id": "11f4b088-e6f9-4c96-baa7-cfc1859ecae8" }
  ],
  // Select at BUILD time with CLOUDFLARE_ENV. Deploy the generated config
  // without --env. Names, routes and vars must be explicit in each env.
  "env": {
    "production": {
      "name": "paibot-app",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "paibot.app", "custom_domain": true }],
      "vars": { "SITE_URL": "https://paibot.app", "SITE_INDEXABLE": "true", "WHOIS_ROOT_SERVER": "whois.iana.org:43", "RDAP_BOOTSTRAP_URL": "https://data.iana.org/rdap/dns.json", "SITE_CHECK_ALLOW_PRIVATE": "false", "APP_VERSION": "local" },
      // Not inherited from the top level - production has its own database
      // (infra/d1.tf's app_prod_apac), never the dev one.
      "d1_databases": [
        { "binding": "DB", "database_name": "paibot-app-apac", "database_id": "fdfaf455-d8c4-4652-a2a0-4ccda9ed1d61" }
      ]
    }
  }
}
